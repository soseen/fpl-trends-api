# Keep DATABASE_URL in the existing private .env. Limit Prisma's pool to fit
# the 4 GiB host; use a separate migration connection when deploying.
# DATABASE_URL=postgresql://.../fpl-trends-db?connection_limit=4&pool_timeout=5
# ANALYTICS_READ_DATABASE_URL=postgresql://fpl_analytics_read:...@127.0.0.1/fpl-trends-db
ANALYTICS_PRUNE_WORKING_FACTS=false
# Optional off-site backup/monitoring settings. These scripts use standard libpq
# PG variables or ~/.pg_service.conf and ~/.pgpass, never the Prisma URL.
# PGSERVICE=fpl-backup
# PGDATABASE=fpl-trends-db
# BACKUP_SSH_TARGET=backup-user@backup-host
# BACKUP_REMOTE_DIR=/srv/backups/fpl
REQUIRE_OFFSITE_BACKUP=false
